# Copy to .env and adjust as needed
PORT=4000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=faz
PGPASSWORD=faz_password
PGDATABASE=fortianalyzer

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Syslog UDP listener (set SYSLOG_ENABLED=false to disable)
SYSLOG_ENABLED=true
SYSLOG_PORT=514
SYSLOG_HOST=0.0.0.0

# CORS origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173
