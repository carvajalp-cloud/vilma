{
  "name": "fortianalyzer-clone-backend",
  "version": "1.0.0",
  "description": "Vilma — FortiAnalyzer-style log analytics backend: syslog ingestion, auth, RBAC, multi-tenant ADOMs",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "bootstrap": "node src/db/bootstrap.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "geoip-lite": "^1.4.10",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
